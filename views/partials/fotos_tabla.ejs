<% if (arrFotos && arrFotos.length > 0) { %>
    <div class="d-flex justify-content-end align-items-center mb-3">
        <small class="text-white-50 me-auto">
            Mostrando <%= arrFotos.length %> foto<%= arrFotos.length !== 1 ? 's' : '' %>
        </small>
        <div class="btn-group">
            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#agregarFotoModal">
                <i class="material-icons">add</i>
                Agregar Foto
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="location.reload()">
                <i class="material-icons">refresh</i>
            </button>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
        <% arrFotos.forEach((foto) => { %>
            <div class="col">
                <div class="card photo-card">
                    <img src="<%= foto.url %>" 
                         alt="<%= foto.descripcion %>" 
                         class="card-img-top"
                         onerror="this.onerror=null;this.src='https://via.placeholder.com/400?text=Invalid+Image';">
                    <div class="card-body">
                        <h5 class="card-title" title="<%= foto.descripcion %>"><%= foto.descripcion %></h5>
                        <div class="d-flex justify-content-end">
                            <div class="btn-group" role="group">
                                <button type="button" class="btn btn-sm btn-outline-primary" title="Editar">
                                    <i class="material-icons">edit</i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-info" title="Ver">
                                    <i class="material-icons">visibility</i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                    <i class="material-icons">delete</i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        <% }); %>
    </div>

<% } else { %>

    <div class="empty-gallery">
        <i class="material-icons">photo_library</i>
        <h5 class="mt-3">Galería Vacía</h5>
        <p>Parece que aún no has subido ninguna foto.</p>
        <button type="button" class="btn btn-primary mt-3" data-bs-toggle="modal" data-bs-target="#agregarFotoModal">
            <i class="material-icons">add</i>
            Agregar la Primera Foto
        </button>
    </div>

<% } %>

<!-- Modal para agregar foto -->
<div class="modal fade" id="agregarFotoModal" tabindex="-1" aria-labelledby="agregarFotoModalLabel" aria-hidden="true" data-bs-theme="dark">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="agregarFotoModalLabel">
                    <i class="material-icons">add_photo_alternate</i>
                    Agregar Nueva Foto
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/photos/add" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="descripcion" class="form-label">Descripción</label>
                        <input type="text" class="form-control" id="descripcion" name="descripcion" placeholder="Ej: Atardecer en la playa" required>
                    </div>
                    <div class="mb-3">
                        <label for="url" class="form-label">URL de la imagen</label>
                        <input type="url" class="form-control" id="url" name="url" placeholder="https://ejemplo.com/imagen.jpg" required>
                    </div>
                    <div class="mb-3">
                        <label for="imagenPreview" class="form-label">Vista previa</label>
                        <div class="text-center p-3 border rounded" id="previewPlaceholder">
                            <img id="imagenPreview" src="" alt="Vista previa" style="max-width: 100%; max-height: 200px; display: none; border-radius: .25rem;">
                            <div id="previewTextPlaceholder" class="text-white-50">
                                <i class="material-icons" style="font-size: 48px;">image</i>
                                <p>La vista previa aparecerá aquí</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar Foto</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const modal = document.getElementById('agregarFotoModal');
        if (!modal) return;

        const urlInput = modal.querySelector('#url');
        const imagenPreview = modal.querySelector('#imagenPreview');
        const previewTextPlaceholder = modal.querySelector('#previewTextPlaceholder');
        
        const updatePreview = () => {
            const url = urlInput.value.trim();
            if (url) {
                imagenPreview.src = url;
                imagenPreview.style.display = 'block';
                previewTextPlaceholder.style.display = 'none';
                
                imagenPreview.onerror = function() {
                    imagenPreview.style.display = 'none';
                    previewTextPlaceholder.style.display = 'block';
                };
            } else {
                imagenPreview.src = '';
                imagenPreview.style.display = 'none';
                previewTextPlaceholder.style.display = 'block';
            }
        };
        
        if(urlInput) {
            urlInput.addEventListener('input', updatePreview);
        }

        // Reset form on modal close
        modal.addEventListener('hidden.bs.modal', () => {
            modal.querySelector('form').reset();
            updatePreview();
        });
    });
</script> 