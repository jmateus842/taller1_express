<main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">
            <i class="material-icons">dashboard</i>
            Tablero
        </h1>
        <div class="btn-toolbar mb-2 mb-md-0">
            <div class="btn-group me-2">
                <button type="button" class="btn btn-sm btn-outline-secondary">
                    <i class="material-icons">share</i>
                    Compartir
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary">
                    <i class="material-icons">file_download</i>
                    Exportar
                </button>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Bienvenido a <%= title %></h5>
                </div>
                <div class="card-body">
                    <p class="card-text">Este es tu tablero de administracion. Usa el menu de navegacion para acceder a diferentes secciones.</p>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="card bg-primary text-white mb-3">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <h4>125</h4>
                                            <p>Total de Usuarios</p>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="material-icons" style="font-size: 48px;">people</i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <a href="/photos" class="text-decoration-none">
                                <div class="card bg-success text-white mb-3">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between">
                                            <div>
                                                <h4>API</h4>
                                                <p>Galeria de Fotos</p>
                                                <small>Haz clic para ver →</small>
                                            </div>
                                            <div class="align-self-center">
                                                <i class="material-icons" style="font-size: 48px;">photo_library</i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-warning text-white mb-3">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <h4>89</h4>
                                            <p>Sesiones Activas</p>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="material-icons" style="font-size: 48px;">trending_up</i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main> 